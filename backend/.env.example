APP_NAME=clg-prj
APP_ENV=development
DEBUG=True
BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL the browser uses to reach the API (baked into the frontend at build time).
FRONTEND_API_URL=http://127.0.0.1:8000

# Where password-setup links in outgoing email point.
FRONTEND_URI=http://localhost:3000


# ---------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256


# ---------------------------------------------------------------- database
# TWO databases exist depending on how you run the backend. Confusing them is
# the fastest way to "fix" a bug that isn't there.
#
# 1. Backend on the HOST (uvicorn from backend/):
#    DATABASE_URL below. A Postgres must be listening on localhost:5432.
#
# 2. Backend in DOCKER (docker compose up):
#    docker-compose.yml overrides DATABASE_URL for the backend container using
#    the POSTGRES_* values below. The API then serves the `college_db` database
#    inside the `college_postgres` container, which has NO host port mapping:
#      docker exec -it college_postgres psql -U college_user -d college_db
#
# Check which is live:
#   docker exec college_backend printenv DATABASE_URL
DATABASE_URL=postgresql+asyncpg://college_user:change_me@localhost:5432/college_db

POSTGRES_DB=college_db
POSTGRES_USER=college_user
POSTGRES_PASSWORD=change_me


# ---------------------------------------------------------------- mail
# Forgot-password emails need real SMTP credentials; leaving these blank makes
# the endpoint return success but send nothing, and the user is stranded.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=